# Database (PostgreSQL with the pgvector extension enabled)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/gapfinder

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
LLM_MODEL=claude-sonnet-5

# App
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# Demo account (preloaded for judges/reviewers)
DEMO_USER_EMAIL=demo@gapfinder.ai
DEMO_USER_PASSWORD=demo123
