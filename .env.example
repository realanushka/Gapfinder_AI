# ===========================================================================
# GapFinder AI - single environment file for the whole project.
# Copy this file to .env (in this same root folder) and fill in the values.
# Read by the backend (backend/app/config.py) and the frontend (frontend/next.config.ts).
# On Render / Vercel, set these in the dashboard instead; no file is needed there.
# ===========================================================================

# ----------------------------- BACKEND -------------------------------------

# Database: PostgreSQL with pgvector (Supabase: Session pooler, port 5432).
# Remove the [ ] around the password; percent-encode @ : / ? # in it.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/gapfinder

# Auth: generate with  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Text generation: Google Gemini free tier (key: https://aistudio.google.com/apikey).
# LLM_MODEL is a comma-separated list, best first; the app falls back to the next
# model when one hits its daily cap. To use Claude instead:
# LLM_PROVIDER=anthropic, LLM_MODEL=claude-sonnet-5, and set ANTHROPIC_API_KEY.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash,gemini-3.1-flash-lite,gemini-3.7-flash,gemini-3.8-flash,gemini-3.5-flash-lite
ANTHROPIC_API_KEY=

# Embeddings: Gemini (uses LLM_API_KEY unless EMBEDDING_API_KEY is set).
# Leave EMBEDDING_BASE_URL empty to use OpenAI with OPENAI_API_KEY instead.
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
EMBEDDING_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=1536
OPENAI_API_KEY=

# App: CORS_ORIGINS is a comma-separated list of frontend URLs allowed to call the API.
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# Demo account (preloaded by: python -m scripts.seed_demo)
DEMO_USER_EMAIL=demo@gapfinder.ai
DEMO_USER_PASSWORD=demo123

# ----------------------------- FRONTEND ------------------------------------

# Base URL of the FastAPI backend (must start with NEXT_PUBLIC_ to reach the browser).
# In production: your Render URL, no trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:8000
